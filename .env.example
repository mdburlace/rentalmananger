# Copy to .env (or set in Portainer's stack environment variables)
RM_PORT=8085
RM_COOKIE_SECURE=false
# RM_SECRET_KEY=
# RM_DATABASE_URL=postgresql+psycopg://rental:password@db:5432/rental
# RM_MAX_UPLOAD_MB=25

# "Forgot password?" emails (optional). Example for Gmail – use an App Password,
# not your normal password: Google Account → Security → 2-Step Verification → App passwords.
# RM_PUBLIC_URL=https://rent.example.com
# RM_SMTP_HOST=smtp.gmail.com
# RM_SMTP_PORT=587
# RM_SMTP_SECURITY=starttls
# RM_SMTP_USERNAME=you@gmail.com
# RM_SMTP_PASSWORD=your-16-char-app-password
# RM_SMTP_FROM=Rental Manager <you@gmail.com>
